<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
         xmlns="https://jakarta.ee/xml/ns/jakartaee" 
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_5_0.xsd" 
         version="5.0">

    <!--
      Versão dos arquivos CSS e JS. Vai no fim de cada endereço (estilo.css?v=2026.10.20-1).
      Quando um CSS ou JS mudar, troque este valor (e o ?v= dos @import nos arquivos css/*.css):
      o endereço muda e o navegador baixa a versão nova em vez de usar a cópia antiga em cache.
    -->
    <context-param>
        <param-name>versaoArquivos</param-name>
        <param-value>2026.10.20-1</param-value>
    </context-param>

    <!-- Sessão: expira após 30 min sem atividade; o cookie não é acessível por
         JavaScript (http-only) e o ID nunca aparece na URL (só por cookie). -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <error-page>
        <error-code>404</error-code>
        <location>/app-error-404</location>
    </error-page>

    <!-- Erros internos usam a mesma página (o 404.jsp adapta o texto ao código) -->
    <error-page>
        <error-code>500</error-code>
        <location>/app-error-404</location>
    </error-page>

    <!-- ==========================================================
         PÁGINAS INSTITUCIONAIS (só conteúdo, sem dados do banco)
         Não precisam de um Controller em Java: o próprio Tomcat
         mostra o JSP quando alguém abre o endereço. Assim a URL fica
         limpa (/sobre) e o JSP continua protegido dentro de WEB-INF.
         ========================================================== -->

    <!-- Nossa História -->
    <servlet>
        <servlet-name>PaginaSobre</servlet-name>
        <jsp-file>/WEB-INF/views/sobre.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>PaginaSobre</servlet-name>
        <url-pattern>/sobre</url-pattern>
    </servlet-mapping>

    <!-- Contato: agora é o ContatoController (@WebServlet("/contato")) -->

    <!-- Central de Ajuda (FAQ) -->
    <servlet>
        <servlet-name>PaginaAjuda</servlet-name>
        <jsp-file>/WEB-INF/views/ajuda.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>PaginaAjuda</servlet-name>
        <url-pattern>/ajuda</url-pattern>
    </servlet-mapping>

    <!-- Entregas, trocas e devoluções -->
    <servlet>
        <servlet-name>PaginaEntregasTrocas</servlet-name>
        <jsp-file>/WEB-INF/views/entregas-trocas.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>PaginaEntregasTrocas</servlet-name>
        <url-pattern>/entregas-e-trocas</url-pattern>
    </servlet-mapping>

    <!-- Política de Privacidade (LGPD) -->
    <servlet>
        <servlet-name>PaginaPrivacidade</servlet-name>
        <jsp-file>/WEB-INF/views/privacidade.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>PaginaPrivacidade</servlet-name>
        <url-pattern>/privacidade</url-pattern>
    </servlet-mapping>

    <!-- Termos de Uso -->
    <servlet>
        <servlet-name>PaginaTermos</servlet-name>
        <jsp-file>/WEB-INF/views/termos.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>PaginaTermos</servlet-name>
        <url-pattern>/termos</url-pattern>
    </servlet-mapping>

</web-app>